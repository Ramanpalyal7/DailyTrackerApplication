# ============================================
# LapWork Website - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to GitHub!

# ============================================
# DATABASE (Neon Postgres)
# ============================================
# Get this from Neon Dashboard → Connection Details
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ============================================
# CLOUDFLARE (R2 Storage + Worker)
# ============================================
# Worker URL - found in Cloudflare Dashboard → Workers & Pages
# Format: https://your-worker-name.your-subdomain.workers.dev
WORKER_URL="https://lapwork-downloads.srivastavarishabh2001.workers.dev"

# R2 Credentials - found in Cloudflare Dashboard → R2 → Manage API Tokens
CLOUD_FLARE_R2_ACCESS_KEY_ID=""
CLOUD_FLARE_R2_SECRET_ACCESS_KEY=""
CLOUD_FLARE_R2_S3_ENDPOINT_URL="https://your-account.r2.cloudflarestorage.com"

# ============================================
# UPSTASH REDIS (For Rate Limiting + Active Visitors)
# ============================================
# Get from Upstash Console → Your Database → REST API
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ============================================
# GITHUB (For Release Sync)
# ============================================
# Format: owner/repository-name
GITHUB_REPO="Ramanpalyal7/DailyTrackerApplication"

# Optional: For higher rate limits (5000 requests/hour vs 60)
# Get from GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=""

# ============================================
# APP CONFIG
# ============================================
PORT=3000
NODE_ENV="development"